{
  "$schema": "https://raw.githubusercontent.com/nicholasio/tauri-apps/tauri/dev/crates/tauri-utils/schema/capabilities.json",
  "identifier": "default",
  "description": "Default capability for IPSwitcher",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    "opener:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
